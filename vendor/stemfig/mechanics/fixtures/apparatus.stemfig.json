{
  "schema": "stemfig/v1",
  "latex": "mathjax",
  "plugins": ["physics.mechanics@1"],
  "nodes": [
    {
      "id": "mechanics_apparatus_sheet",
      "type": "frame",
      "name": "용수철·도르래·받침대",
      "frame": { "x": 0, "y": 0, "w": 180, "h": 100 },
      "children": [
        {
          "id": "mechanics_spring", "type": "figure", "kind": "physics.mechanics", "name": "용수철과 물체",
          "frame": { "x": 4, "y": 5, "w": 54, "h": 90 },
          "view": { "xmin": 0, "xmax": 10, "ymin": 0, "ymax": 10 },
          "spec": {
            "objects": [
              { "id": "title", "type": "label", "label": "용수철", "labelSize": 3,
                "at": { "mode": "free", "point": [5, 9.2] } },
              { "id": "ceiling", "type": "guide", "dashed": false,
                "a": { "mode": "free", "point": [3, 8] }, "b": { "mode": "free", "point": [7, 8] } },
              { "id": "mass", "type": "block", "width": 1.8, "height": 1.2, "label": "$m$", "labelSize": 3,
                "pose": { "mode": "free", "point": [5, 2.2], "angle": 0 } },
              { "id": "spring", "type": "spring", "width": 1, "coils": 9, "label": "$k$", "labelSize": 3,
                "a": { "mode": "free", "point": [5, 8] }, "b": { "mode": "anchor", "object": "mass", "anchor": "top" } },
              { "id": "length", "type": "dimension", "axis": "vertical", "offset": 0, "label": "$\\ell$", "labelSize": 3,
                "a": { "mode": "anchor", "object": "mass", "anchor": "top", "offset": [2.5, 0] }, "b": { "mode": "free", "point": [7.5, 8] } },
              { "id": "weight", "type": "force", "delta": [0, -1.2], "label": "$mg$", "labelSize": 3,
                "from": { "mode": "anchor", "object": "mass", "anchor": "bottom" } }
            ]
          }
        },
        {
          "id": "mechanics_pulley", "type": "figure", "kind": "physics.mechanics", "name": "책상 위 도르래",
          "frame": { "x": 63, "y": 5, "w": 54, "h": 90 },
          "view": { "xmin": 0, "xmax": 10, "ymin": 0, "ymax": 10 },
          "spec": {
            "objects": [
              { "id": "title", "type": "label", "label": "도르래와 실", "labelSize": 3,
                "at": { "mode": "free", "point": [5, 9.2] } },
              { "id": "table", "type": "track", "rounding": 0, "points": [[1, 2], [1, 5], [6.4, 5], [6.4, 2]] },
              { "id": "mount", "type": "guide", "dashed": false,
                "a": { "mode": "free", "point": [6.4, 5] }, "b": { "mode": "free", "point": [7, 5.1] } },
              { "id": "pulley", "type": "pulley", "center": [7, 5.1], "radius": 0.6 },
              { "id": "A", "type": "block", "width": 1.6, "height": 1.4, "label": "$A$", "labelSize": 3,
                "pose": { "mode": "free", "point": [3, 5], "angle": 0 } },
              { "id": "B", "type": "block", "width": 1.3, "height": 1.4, "label": "$B$", "labelSize": 3,
                "pose": { "mode": "free", "point": [7.6, 1.1], "angle": 0 } },
              { "id": "rope", "type": "rope", "pulley": "pulley", "wrap": "cw", "label": "$T$", "labelSize": 3,
                "a": { "mode": "anchor", "object": "A", "anchor": "right" },
                "b": { "mode": "anchor", "object": "B", "anchor": "top" } }
            ]
          }
        },
        {
          "id": "mechanics_support", "type": "figure", "kind": "physics.mechanics", "name": "막대와 받침대",
          "frame": { "x": 122, "y": 5, "w": 54, "h": 90 },
          "view": { "xmin": 0, "xmax": 10, "ymin": 0, "ymax": 10 },
          "spec": {
            "objects": [
              { "id": "title", "type": "label", "label": "막대와 받침대", "labelSize": 3,
                "at": { "mode": "free", "point": [5, 9.2] } },
              { "id": "beam", "type": "track", "rounding": 0, "points": [[0.8, 5], [9.2, 5]] },
              { "id": "left", "type": "support", "point": [2.6, 5], "width": 1.1, "height": 1.4, "angle": 0 },
              { "id": "right", "type": "support", "point": [7.4, 5], "width": 1.1, "height": 1.4, "angle": 0 },
              { "id": "mass", "type": "block", "width": 1.6, "height": 1.3, "label": "$m$", "labelSize": 3,
                "pose": { "mode": "track", "track": "beam", "t": 0.5, "offset": 0 } },
              { "id": "distance", "type": "dimension", "axis": "horizontal", "offset": -1, "label": "$L$", "labelSize": 3,
                "a": { "mode": "anchor", "object": "left", "anchor": "bottom" },
                "b": { "mode": "anchor", "object": "right", "anchor": "bottom" } }
            ]
          }
        }
      ]
    }
  ]
}
