{
  "schema": "stemfig/v1",
  "plugins": ["math.geometry@1"],
  "nodes": [
    {
      "id": "page",
      "type": "frame",
      "frame": { "x": 0, "y": 0, "w": 80, "h": 60 },
      "children": [
        {
          "id": "tri",
          "type": "figure",
          "kind": "math.geometry",
          "frame": { "x": 5, "y": 5, "w": 70, "h": 50 },
          "view": { "xmin": -0.5, "xmax": 4.5, "ymin": -0.5, "ymax": 3.5 },
          "spec": {
            "objects": [
              { "id": "A", "def": ["point", 0, 0], "label": "A" },
              { "id": "B", "def": ["point", 4, 0], "label": "B" },
              { "id": "C", "def": ["point", 1.2, 3], "label": "C" },
              { "id": "c", "def": ["segment", "A", "B"] },
              { "id": "a", "def": ["segment", "B", "C"] },
              { "id": "b", "def": ["segment", "C", "A"] },
              { "id": "M", "def": ["division", "A", "B", 1, 1, "internal"], "label": "M" },
              { "id": "MA", "def": ["division", "B", "C", 1, 1, "internal"], "label": "${\\rm{M}}_a$" },
              { "id": "MB", "def": ["division", "C", "A", 1, 1, "internal"], "label": "${\\rm{M}}_b$" },
              { "id": "am", "def": ["line", "A", "MA"] },
              { "id": "bm", "def": ["line", "B", "MB"] },
              { "id": "G", "def": ["intersect", "am", "bm", 0], "label": "G" },
              { "id": "H", "def": ["projection", "C", "A", "B"], "label": "H" }
            ]
          },
          "interaction": {
            "handles": ["A", "B", "C"],
            "invariants": ["M", "MA", "MB", "G", "H"]
          }
        }
      ]
    }
  ]
}
